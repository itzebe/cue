# --- Required for live mode -------------------------------------------------
# Your Qloo hackathon API key. Without it, Cue serves a pre-computed fixture
# cue sheet so the app still runs end to end.
QLOO_API_KEY=

# Qloo base URL. Hackathon keys ONLY work against the hackathon host.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# --- Optional: the language model -------------------------------------------
# Cue works with any OpenAI-compatible chat-completions endpoint. Set all three
# to use your own provider. If unset, Cue falls back to its deterministic scene
# reader and never calls an LLM at all.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Or use OpenAI directly:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
