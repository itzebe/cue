# --- Required for live mode -------------------------------------------------
# Your Qloo hackathon API key. Without it, Cue serves a pre-computed fixture
# cue sheet so the app still runs end to end.
QLOO_API_KEY=

# Qloo base URL. Hackathon keys ONLY work against the hackathon host.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# --- Optional: the language model -------------------------------------------
# Cue works with any OpenAI-compatible chat-completions endpoint. If no key is
# set at all, Cue falls back to its deterministic scene reader, ranks artists
# from the taste graph and leaves the cut as "Track TBD" rather than inventing
# a title.
#
# Easiest path: set a provider's own key and Cue picks the right base URL and a
# default model for you. No other variable needed.
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys        (free models)
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey (free tier)
# GROQ_API_KEY=              # https://console.groq.com/keys      (free tier)
#
# Or pin any OpenAI-compatible endpoint explicitly, including OpenAI itself.
# All three together override every provider key below.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Precedence, highest first: the LLM_* triple, then OPENROUTER_API_KEY,
# GEMINI_API_KEY/GOOGLE_API_KEY, GROQ_API_KEY.
#
# There is no implicit OpenAI endpoint. A paid key with no balance is worse than
# no key: every cue sheet becomes a paid call that fails, and the app silently
# drops to the deterministic reader. A bare OPENAI_API_KEY therefore resolves to
# nothing. To use OpenAI, name it with the LLM_* triple above. (OPENAI_API_KEY is
# still read as the credential for the Agent Canvas managed proxy, which is
# identified by its own refresh URL, not by the variable name.)
#
# Every configured provider also acts as a fallback for the one above it: if the
# primary is rate-limited or unfunded, the request is handed to the next one
# rather than dropped. Setting the LLM_* triple is terminal — it names an
# endpoint, so nothing else is tried.
